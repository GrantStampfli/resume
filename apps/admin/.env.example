# Login password for the admin UI (required)
NUXT_ADMIN_PASSWORD=change-me

# Session cookie secret (min 32 chars). Auto-generated in dev if missing: `openssl rand -base64 32`
NUXT_SESSION_PASSWORD=

# Storage driver: "fs" (default in dev — edits this checkout) or "github" (default in production)
NUXT_STORAGE_DRIVER=
# Repo root when using the fs driver (defaults to the monorepo root)
NUXT_STORAGE_ROOT=

# GitHub driver: fine-grained token with "Contents: read & write" on the repo
NUXT_GITHUB_TOKEN=
NUXT_GITHUB_REPO=GrantStampfli/resume
NUXT_GITHUB_BRANCH=master

# Vercel Blob (Vercel dashboard → Storage → Blob) for image uploads
BLOB_READ_WRITE_TOKEN=

# Optional Vercel deploy hook pinged after a content change (Vercel → Project → Git → Deploy Hooks)
NUXT_VERCEL_DEPLOY_HOOK_URL=

# Public
NUXT_PUBLIC_PORTFOLIO_URL=https://grantstampfli.com
NUXT_PUBLIC_RESUME_URL=https://gstampfli.com
