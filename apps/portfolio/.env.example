# Content database. When set, the collections build from the rows the admin writes instead of
# the markdown in content/, and newsletter sign-ups are stored. Leave empty to build from files.
# Also read from DATABASE_URL / POSTGRES_URL, so Vercel Postgres works unconfigured.
#   postgres://user:password@host:5432/database
#   file:.data/content.db
CONTENT_DATABASE_URL=

# Public
NUXT_PUBLIC_SITE_URL=https://grantstampfli.com
NUXT_PUBLIC_RESUME_URL=https://gstampfli.com

# Vercel Edge Config connection string (Vercel dashboard → Storage → Edge Config)
EDGE_CONFIG=
NUXT_EDGE_CONFIG=

# Vercel Flags (https://flags-sdk.dev) — `openssl rand -base64 32`
FLAGS_SECRET=
NUXT_FLAGS_SECRET=
