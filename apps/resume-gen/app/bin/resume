#!/usr/bin/env php
<?php

declare(strict_types=1);

use Resume\Cli\Resume;

$autoloaders = [
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../../vendor/autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        break;
    }
}

if (!class_exists(Resume::class)) {
    fwrite(\STDERR, 'Dependencies are missing. Run `composer install` in '.dirname(__DIR__)."\n");
    exit(1);
}

$templatePath = getenv('RESUME_TEMPLATE_PATH') ?: realpath(__DIR__.'/../templates');

exit((new Resume($templatePath))->run());
