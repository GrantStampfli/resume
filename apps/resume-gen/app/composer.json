{
    "name": "grantstampfli/resume-gen",
    "description": "Markdown Resume Generator",
    "homepage": "https://github.com/grantstampfli/resume",
    "keywords": [
        "markdown",
        "resume",
        "html5",
        "pdf"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "michelf/php-markdown": "^2.0",
        "michelf/php-smartypants": "^1.8",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/process": "^7.3 || ^8.0",
        "twig/twig": "^3.21",
        "wikimedia/less.php": "^5.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Resume\\": "src/Resume/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Resume\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/resume"
    ],
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
